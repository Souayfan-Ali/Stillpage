{
  "name": "glassmere",
  "version": "1.0.0",
  "private": true,
  "description": "A fully declarative Manifest V3 content blocker for Chrome.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare:types": "wxt prepare",
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "typecheck": "npm run -s prepare:types && tsc -p src && tsc -p compiler && tsc -p tests && tsc -p bench && tsc -p scripts && tsc -p .",
    "lint": "eslint --max-warnings=0 .",
    "test": "vitest run --coverage",
    "verify": "npm run -s typecheck && npm run -s lint && npm run -s knip && npm run -s test && npm run -s build && npm run -s size",
    "test:watch": "vitest",
    "test:dnr": "vitest run --config vitest.dnr.config.ts",
    "test:e2e": "npm run -s build && playwright test",
    "test:perf": "vitest run --config vitest.perf.config.ts && npm run -s build && GLASSMERE_PERF=1 E2E_SCALE=1 playwright test --config playwright.perf.config.ts",
    "test:e2e:install": "playwright install chromium",
    "store:assets": "npm run -s build && GLASSMERE_STORE_ASSETS=1 playwright test tests/e2e/store",
    "knip": "knip",
    "bench": "jiti bench/run/main.ts",
    "repro": "jiti scripts/repro/main.ts",
    "bench:shadow": "jiti bench/shadow/main.ts",
    "size": "size-limit",
    "tools:install": "bash scripts/install-tools.sh",
    "lint:workflows": ".cache/tools/bin/actionlint -color",
    "secrets:scan": ".cache/tools/bin/gitleaks git --redact --no-banner --config .gitleaks.toml .",
    "hooks:install": "git config core.hooksPath .githooks",
    "lists:fetch": "jiti compiler/fetch/main.ts",
    "lists:build": "jiti compiler/build/main.ts",
    "oracle:extract": "jiti compiler/oracle/main.ts",
    "oracle:fetch": "bash scripts/fetch-ubol.sh",
    "vendor:fetch": "jiti compiler/vendor/main.ts",
    "release": "jiti compiler/release/main.ts"
  },
  "devDependencies": {
    "@adguard/agtree": "4.4.0",
    "@adguard/dnr-converter": "2.1.0",
    "@playwright/test": "1.65.0",
    "@size-limit/file": "14.3.0",
    "@testing-library/preact": "3.2.6",
    "@types/chrome": "0.3.7",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.1.0",
    "axe-core": "4.14.0",
    "eslint": "10.14.0",
    "fast-check": "4.10.2",
    "jiti": "2.7.0",
    "jsdom": "30.1.3",
    "knip": "6.45.1",
    "rolldown": "1.2.19",
    "size-limit": "14.3.0",
    "terser": "5.51.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "wxt": "0.21.5",
    "zod": "4.6.7"
  },
  "dependencies": {
    "@preact/signals": "2.11.4",
    "preact": "11.2.0",
    "valibot": "1.5.0"
  }
}
